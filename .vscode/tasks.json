{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Android over USB",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\run_android_usb.ps1"
      ],
      "problemMatcher": []
    },
    {
