{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug (Cloud Supabase from env)",
      "request": "launch",
      "type": "dart",
      "args": [
        "--dart-define=SUPABASE_URL=${env:SUPABASE_URL}",
        "--dart-define=SUPABASE_ANON_KEY=${env:SUPABASE_ANON_KEY}",
        "--dart-define=SPOONACULAR_API_KEY=${env:SPOONACULAR_API_KEY}"
      ]
    },
    {
      "name": "Debug (Local Supabase Desktop)",
      "request": "launch",
      "type": "dart",
      "args": [
        "--dart-define=SUPABASE_URL=http://127.0.0.1:54321",
        "--dart-define=SUPABASE_ANON_KEY=${env:SUPABASE_LOCAL_ANON_KEY}",
        "--dart-define=SPOONACULAR_API_KEY=${env:SPOONACULAR_API_KEY}"
      ]
    },
    {
      "name": "Debug (Local Supabase Android Emulator)",
      "request": "launch",
      "type": "dart",
      "args": [
        "--dart-define=SUPABASE_URL=http://10.0.2.2:54321",
        "--dart-define=SUPABASE_ANON_KEY=${env:SUPABASE_LOCAL_ANON_KEY}",
        "--dart-define=SPOONACULAR_API_KEY=${env:SPOONACULAR_API_KEY}"
      ]
    },
    {
      "name": "Profile (Cloud Supabase from env)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "profile",
      "args": [
        "--dart-define=SUPABASE_URL=${env:SUPABASE_URL}",
        "--dart-define=SUPABASE_ANON_KEY=${env:SUPABASE_ANON_KEY}",
        "--dart-define=SPOONACULAR_API_KEY=${env:SPOONACULAR_API_KEY}"
      ]
    }
  ]
}
